# Application
APP_NAME=Entartica WhatsApp Chatbot
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Exotel
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_BASE_URL=https://api.exotel.com
EXOTEL_WHATSAPP_FROM=
EXOTEL_STATUS_CALLBACK_URL=
PUBLIC_BASE_URL=
EXOTEL_OUTBOUND_ENABLED=false
EXOTEL_SIGNATURE_VALIDATION_ENABLED=false

# MVP location scope (Raipur only until other locations are expressly approved)
MVP_DEFAULT_LOCATION_CODE=raipur
MVP_ENABLED_LOCATION_CODES=raipur

# OpenAI embeddings (set both model and dimensions from the approved account configuration)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=
# Optional: required only for the safe conversational fallback.
OPENAI_CHAT_MODEL=

# Knowledge retrieval acceptance threshold and maximum returned chunks
KNOWLEDGE_MIN_SIMILARITY=0.65
KNOWLEDGE_TOP_K=5
KNOWLEDGE_LEXICAL_MIN_SCORE=0.30

# Availability rows older than this are never presented as current.
AVAILABILITY_MAX_AGE_MINUTES=30
RAIPUR_AVAILABILITY_PROVIDER=unavailable
RAIPUR_INBOUND_ORCHESTRATOR_ENABLED=false
RAIPUR_DRAFT_CREATION_ENABLED=false
RAIPUR_DRAFT_REVIEW_MIGRATION_READY=false
RAIPUR_APPROVED_DRAFT_SEND_ENABLED=false
RAIPUR_AUTOMATIC_REPLY_ENABLED=false
RAIPUR_LANGGRAPH_ENABLED=false
RAIPUR_LANGGRAPH_COMPARISON_MODE=false
RAIPUR_AUTOMATIC_REPLY_INTENTS=information,location,services
ENTARTICA_SALES_PHONE=+919429691418
ENTARTICA_SALES_EMAIL=sales@entartica.com
RAIPUR_CONVERSATION_CONTEXT_TTL_MINUTES=120
CONVERSATION_SESSION_TTL_MINUTES=30
RAIPUR_OUTBOUND_TEST_RECIPIENTS=

# Add integration credentials only when the relevant milestone is implemented.
# Never commit a real .env file.
